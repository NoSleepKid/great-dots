{
    "layer": "top",
    "position": "top",
    "spacing": 5,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],
    "hyprland/workspaces": {
        "format": " {}",
        "format-active": " {}",
        "format-occupied": " {}",
        "format-empty": " {}",
        "on-click": "activate"
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "tooltip-format": "<small>{:%A, %B %d, %Y}</small>",
        "format-alt": " {:%A, %B %d}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}"
    },

    "battery": {
        "states": {
            "good": 90,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚦 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{time} left"
    },
    
    "tray": {
        "icon-size": 20,
        "spacing": 10
    }
}
