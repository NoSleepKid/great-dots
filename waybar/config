{
  "layer": "top",
  "position": "top",
  "height": 45,
  "spacing": 10,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["custom/hypr_button"],
  "modules-center": ["hyprland/workspaces", "clock"],
  "modules-right": ["cpu", "memory", "bluetooth", "pulseaudio", "network", "tray"],
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": " {usage}%",
    "on-click": "alacritty -e htop"
  },
  "memory": {
    "format": " {used:0.1f}G/{total:0.1f}G",
    "on-click": "alacritty -e htop"
  },
  "bluetooth": {
    "format": " {status}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": " ",
    "format-icons": {
      "default": ["", ""]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": " {essid} ({ipaddr})",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 Offline"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "custom/hypr_button": {
    "format": "󰣇",
    "on-click": "rofi -show drun"
  }
}
